#!/usr/bin/env bash


# Put native Apple Silicon Homebrew ahead of everything else on PATH.
# macOS's own /etc/paths lists /usr/local/bin (and /etc/paths.d/homebrew
# appends /opt/homebrew/bin *after* it), so without this, a legacy Intel
# Homebrew install left over at /usr/local -- still present and separately
# updated via Rosetta on this Mac -- silently shadows the correct arm64
# binaries for anything installed in both places (vim, bash, tig, uv, jq,
# watch, openssl, the xz/zstd/lz4 tools, etc.), which is what caused
# `vim +PlugInstall` to abort on a stale x86_64 liblua dependency and `gh`
# to fail with a cryptic "unable to load libxcrun" error.
export PATH="/opt/homebrew/bin:/opt/homebrew/sbin:$PATH"


# Make vim the default editor.
export EDITOR='vim';


# Enable persistent REPL history for `node`.
export NODE_REPL_HISTORY=~/.node_history;


# Allow 32³ entries; the default is 1000.
export NODE_REPL_HISTORY_SIZE='32768';


# Use sloppy mode by default, matching web browsers.
export NODE_REPL_MODE='sloppy';


# Make Python use UTF-8 encoding for output to stdin, stdout, and stderr.
export PYTHONIOENCODING='UTF-8';


# Increase Bash history size. Allow 32³ entries; the default is 500.
export HISTSIZE='32768';
export HISTFILESIZE="${HISTSIZE}";


# Omit duplicates and commands that begin with a space from history.
export HISTCONTROL='ignoreboth';


# Prefer US English and use UTF-8.
export LANG='en_US.UTF-8';
export LC_ALL='en_US.UTF-8';


# Highlight section titles in manual pages.
export LESS_TERMCAP_md="${yellow}";


# Don’t clear the screen after quitting a manual page.
export MANPAGER='less -X';


# docker push will not have to ask me for user name.
export DOCKER_ID_USER='songgithub'


# for Py env
export PYENV_VERSION='3.6.3'
export PYENV_ROOT="$HOME/.pyenv"
export PATH="$PYENV_ROOT/bin:$PATH"

## Prefer to use Pyvenv instead of virtualenv
export PYENV_VIRTUALENVWRAPPER_PREFER_PYVENV="true"


# virtualenv wrapper
export WORKON_HOME=$HOME/.virtualenvs
export PROJECT_HOME=$HOME/code
export VIRTUALENVWRAPPER_PYTHON=/opt/homebrew/bin/python3
export VIRTUALENVWRAPPER_VIRTUALENV=/opt/homebrew/bin/virtualenv


# uv-installed CLI tools (specify-cli / Spec Kit, etc.) land here.
# Equivalent to what `uv tool update-shell` writes to ~/.zshenv, but tracked.
export PATH="$HOME/.local/bin:$PATH"


# GOPATH
export GOPATH=$HOME/go-workspace
# Resolved dynamically rather than hardcoded to a Homebrew path: under the
# flake.nix path (specs/001-declarative-machine-setup) `go` comes from
# nixpkgs, at a store path that changes per version/rebuild, so a fixed
# `/opt/homebrew/opt/go/libexec` would be wrong there -- and modern `go`
# already knows its own GOROOT, so this only needs to be exported at all
# for tooling that reads the env var instead of asking the binary.
command -v go >/dev/null 2>&1 && export GOROOT="$(go env GOROOT)"
export GOBIN=$GOPATH/bin
export PATH="$PATH:$GOPATH/bin"
export PATH="$PATH:$GOROOT/bin"
export PATH="$PATH:$HOME/bin"


